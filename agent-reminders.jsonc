{
  "agents": {
    "Orchestrator": [
      {
        "message": "Remember your prompt - you SHOULD delegate grunt work for efficiency (soft block, you can retry if you want)",
        // Invocation resets the interval, regardless of the tool's result.
        "resetTools": ["task"],
        // Delegable grunt work carries the signal; a preCompact latch
        // therefore waits for the next such call.
        "signalOnTools": ["bash", "powershell", "glob", "web_fetch"],
        "condition": {
          "type": "any",
          "conditions": [
            {
              "type": "toolCalls",
              "count": 10,
              "tools": ["bash", "powershell", "glob", "web_fetch"]
            },
            // Record the event now; deliver at the next tool call.
            {
              "type": "event",
              "event": "preCompact"
            }
          ]
        }
      }
    ]
  }
}
