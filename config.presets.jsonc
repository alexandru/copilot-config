// JSONC input: comments supported.
{
  "default": {
    "extends": ["work-openai"],
  },
  "work-claude": {
    "settings.json": {
      // -----
      // Orchestrator / Solo configuration (main agents)
      "model": "claude-sonnet-5.5",
      "effortLevel": "medium",
      "contextTier": "long_context",
      // -=-=-
      "subagents": {
        "agents": {
          "Junior": {
            "model": "claude-haiku-5.5",
            "effortLevel": "high",
            "contextTier": "long_context",
          },
          // Built-ins, although these should be disabled (hopefully)
          "explore": {
            "model": "claude-haiku-5.5",
            "effortLevel": "medium",
            "contextTier": "default",
          },
          "task": {
            "model": "claude-haiku-5.5",
            "effortLevel": "medium",
            "contextTier": "default",
          },
          "general-purpose": {
            "model": "claude-haiku-5.5",
            "effortLevel": "medium",
            "contextTier": "default",
          },
          "rubber-duck": {
            "model": "claude-haiku-5.5",
            "effortLevel": "medium",
            "contextTier": "default",
          },
          "code-review": {
            "model": "claude-haiku-5.5",
            "effortLevel": "medium",
            "contextTier": "default",
          },
          "research": {
            "model": "claude-haiku-5.5",
            "effortLevel": "medium",
            "contextTier": "default",
          },
          "security-review": {
            "model": "claude-haiku-5.5",
            "effortLevel": "medium",
            "contextTier": "default",
          },
        },
      },
    },
    "mcp-config.json": {
      "mcpServers": {},
    },
  },
  "work-openai": {
    "settings.json": {
      // -----
      // Orchestrator / Solo configuration (main agents)
      "model": "gpt-6.1-terra",
      "effortLevel": "medium",
      "contextTier": "default",
      // -=-=-
      "subagents": {
        "agents": {
          "Junior": {
            "model": "gpt-6-luna",
            "effortLevel": "high",
            "contextTier": "long_context",
          },
          // Built-ins, although these should be disabled (hopefully)
          "explore": {
            "model": "gpt-6-luna",
            "effortLevel": "medium",
            "contextTier": "default",
          },
          "task": {
            "model": "gpt-6-luna",
            "effortLevel": "medium",
            "contextTier": "default",
          },
          "general-purpose": {
            "model": "gpt-6-luna",
            "effortLevel": "medium",
            "contextTier": "default",
          },
          "rubber-duck": {
            "model": "gpt-6-luna",
            "effortLevel": "medium",
            "contextTier": "default",
          },
          "code-review": {
            "model": "gpt-6-luna",
            "effortLevel": "medium",
            "contextTier": "default",
          },
          "research": {
            "model": "gpt-6-luna",
            "effortLevel": "medium",
            "contextTier": "default",
          },
          "security-review": {
            "model": "gpt-6-luna",
            "effortLevel": "medium",
            "contextTier": "default",
          },
        },
      },
    },
    "mcp-config.json": {
      "mcpServers": {},
    },
  },
  "personal": {
    "settings.json": {
      "model": "gpt-6.1-terra",
      "effortLevel": "medium",
      "subagents": {
        "agents": {
          "Junior": {
            "model": "gpt-6.1-terra",
            "effortLevel": "medium",
          },
          // Built-ins, although these should be disabled (hopefully)
          "explore": {
            "model": "gpt-6-luna",
            "effortLevel": "medium",
            "contextTier": "default",
          },
          "task": {
            "model": "gpt-6-luna",
            "effortLevel": "medium",
            "contextTier": "default",
          },
          "general-purpose": {
            "model": "gpt-6-luna",
            "effortLevel": "medium",
            "contextTier": "default",
          },
          "rubber-duck": {
            "model": "gpt-6-luna",
            "effortLevel": "medium",
            "contextTier": "default",
          },
          "code-review": {
            "model": "claude-sonnet-5",
            "effortLevel": "medium",
            "contextTier": "default",
          },
          "research": {
            "model": "claude-sonnet-5",
            "effortLevel": "medium",
            "contextTier": "default",
          },
          "security-review": {
            "model": "claude-sonnet-5",
            "effortLevel": "medium",
            "contextTier": "default",
          },
        },
      },
    },
    "mcp-config.json": {
      "mcpServers": {
        "mcp-intellij-idea": {
          "type": "sse",
          "url": "http://localhost:64342/sse",
          "tools": ["*"],
        },
        "mcp-metals": {
          "type": "http",
          "url": "http://localhost:54640/mcp",
          "tools": ["*"],
        },
        "mcp-chrome-devtools": {
          "type": "local",
          "command": "npx",
          "args": ["-y", "chrome-devtools-mcp@latest"],
          "tools": ["*"],
        },
        "mcp-playwright": {
          "type": "local",
          "command": "npx",
          "args": ["-y", "@playwright/mcp@latest"],
          "tools": ["*"],
        },
      },
    },
  },
  "work-auto": {
    "extends": ["work-openai"],
    "settings.json": {
      "model": "auto",
      "effortLevel": "medium",
      "autoTier": "balance",
      "subagents": {
        "agents": {
          "Junior": {
            "model": "auto",
            "autoTier": "efficiency",
          },
        }
      }
    },
    "mcp-config.json": {},
  },
  "personal-auto": {
    "extends": ["personal"],
    "settings.json": {
      "model": "auto",
      "autoTier": "balance",
      "subagents": {
        "agents": {
          "Junior": {
            "model": "auto",
            "autoTier": "efficiency",
          },
        }
      }
    },
    "mcp-config.json": {},
  },
}
